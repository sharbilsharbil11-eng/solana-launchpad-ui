# Copy this file to .env.local for local development (Vercel injects
# these automatically in production once you set them in the dashboard
# and add the Postgres integration — see README.md "Real accounts setup").

# Auto-set by Vercel once you add the Postgres storage integration to this
# project. For local dev, paste the connection string Vercel/Neon gives you.
POSTGRES_URL=

# From github.com/settings/developers -> New OAuth App
# Authorization callback URL: https://<your-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# From console.cloud.google.com -> APIs & Services -> Credentials -> Create OAuth client ID
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string, e.g. `openssl rand -hex 32`. Signs the session cookie.
SESSION_SECRET=

# The exact URL this app is deployed at, e.g. https://velo.vercel.app
# Used to build OAuth redirect_uri consistently.
APP_BASE_URL=
